// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique
}

model Product {
  id    String @id @default(uuid())
  name  String
  price Float
}

model Order {
  id        String @id @default(uuid())
  userId    String
  productId String
  status    String
  createdAt DateTime @default(now())
}

model OrderEventOutbox {
  id              String    @id @default(uuid())
  orderId         String
  eventType       String    // e.g., "ORDER_CREATED", "ORDER_UPDATED"
  eventPayload    Json      // The actual event data to publish
  createdAt       DateTime  @default(now())
  publishedAt     DateTime? // NULL = not published yet
  publishAttempts Int       @default(0)
  lastError       String?   // Store error message if publishing fails
  
  @@index([publishedAt]) // Speed up queries for unpublished events
  @@index([createdAt])
  @@map("order_event_outbox")
}

// Tracks which incoming Kafka events this service has already processed.
// Used to make the payment-events consumer idempotent (safe against
// duplicate delivery / redelivery from Kafka).
model ProcessedPaymentEvent { 
  id String @id
  eventType String
  orderId String
  processedAt DateTime @default(now())

  @@index([orderId])
  @@map("processed_payment_event")
}